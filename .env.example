# Kopioi tämä tiedosto nimelle .env ja täytä arvot.
# .env on .gitignoressa — sitä EI koskaan viedä GitHubiin.

# Oppilaitoksesi Canvas-osoite (ilman /api/v1-päätettä).
# Esim. https://<koulu>.instructure.com  tai  https://canvas.<koulu>.fi
CANVAS_BASE_URL=https://oppilaitos.instructure.com

# Henkilökohtainen käyttöoikeustunnus (access token).
# Luo Canvasissa: Tili -> Asetukset -> + Uusi käyttöoikeustunnus.
CANVAS_TOKEN=paste-your-token-here
